/* ============================================================
   AI Extract — Design System QSS
   Register: product  |  Strategy: Restrained  |  Theme: dark surface

   Elevation (lightness-delta only, no shadows):
     Base      #0D0E12   oklch(9%  0.008 255)
     Surface   #111318   oklch(11% 0.008 255)
     Elevated  #17191F   oklch(14% 0.008 255)
     Overlay   #1D2029   oklch(17% 0.008 255)

   Border:
     Subtle    #262B35   oklch(22% 0.010 255)
     Default   #313847   oklch(28% 0.010 255)

   Text:
     Primary   #E8ECF4   oklch(94% 0.008 255)
     Secondary #7A8499   oklch(65% 0.010 255)
     Disabled  #434957   oklch(38% 0.008 255)

   Accent    #3D7EE8   oklch(62% 0.18 255)
   AccentDim #1A2E54   oklch(30% 0.12 255)
   CTA       #C4860A   oklch(70% 0.17  60)
   CTAHover  #A86E06   oklch(62% 0.17  60)
   Error     #D04040   oklch(60% 0.20  25)
   Success   #3E9E6A   oklch(62% 0.16 155)
   ============================================================ */

/* ────────────────────────────────────────────────────────────
   BASE
   ──────────────────────────────────────────────────────────── */
QMainWindow,
QDialog,
QWidget {
    background-color: #0D0E12;
    color: #E8ECF4;
    font-family: "Be Vietnam Pro", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 10.5pt;
}

/* ────────────────────────────────────────────────────────────
   TOOLBAR
   ──────────────────────────────────────────────────────────── */
#toolbar_widget {
    background-color: #0D0E12;
    border-bottom: 1px solid #262B35;
    min-height: 48px;
    max-height: 48px;
}

#app_title_label {
    color: #E8ECF4;
    font-size: 12pt;
    font-weight: 700;
    letter-spacing: 0.3px;
}

#toolbar_separator {
    background-color: #262B35;
    max-width: 1px;
    min-width: 1px;
    margin: 10px 2px;
}

/* ────────────────────────────────────────────────────────────
   PANELS
   ──────────────────────────────────────────────────────────── */
#sidebar_panel {
    background-color: #111318;
    border-right: 1px solid #262B35;
}

#output_panel_widget {
    background-color: #111318;
}

#center_panel {
    background-color: #0D0E12;
}

/* ────────────────────────────────────────────────────────────
   SPLITTER
   ──────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #262B35;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #3D7EE8;
}

/* ────────────────────────────────────────────────────────────
   LABELS
   ──────────────────────────────────────────────────────────── */
QLabel {
    color: #E8ECF4;
    background-color: transparent;
}

#lbl_proofread {
    color: #7A8499;
    font-size: 9pt;
}

#lbl_queue_header {
    color: #7A8499;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0;
}

#file_count_badge {
    background-color: #1D2029;
    color: #7A8499;
    border-radius: 9px;
    padding: 0px 7px;
    font-size: 8pt;
    font-weight: 600;
}

#status_bar_label {
    color: #7A8499;
    font-size: 9pt;
    padding: 2px 6px;
}

/* ────────────────────────────────────────────────────────────
   BUTTONS — BASE
   ──────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #17191F;
    color: #E8ECF4;
    border: 1px solid #313847;
    padding: 6px 14px;
    border-radius: 5px;
    font-weight: 500;
    font-size: 10pt;
}

QPushButton:hover {
    background-color: #1D2029;
    border-color: #3D7EE8;
    color: #E8ECF4;
}

QPushButton:pressed {
    background-color: #111318;
    border-color: #1A2E54;
}

QPushButton:disabled {
    background-color: #111318;
    color: #434957;
    border-color: #262B35;
}

/* ────────────────────────────────────────────────────────────
   BUTTONS — NAMED
   ──────────────────────────────────────────────────────────── */

/* Run — CTA amber */
QPushButton#btn_run {
    background-color: #C4860A;
    color: #0D0E12;
    border: 1px solid #C4860A;
    font-weight: 700;
    font-size: 10.5pt;
    padding: 8px 20px;
    border-radius: 5px;
}
QPushButton#btn_run:hover {
    background-color: #A86E06;
    border-color: #A86E06;
}
QPushButton#btn_run:pressed {
    background-color: #8C5A04;
    border-color: #8C5A04;
}
QPushButton#btn_run:disabled {
    background-color: #17191F;
    color: #434957;
    border-color: #262B35;
}

/* Stop — error red */
QPushButton#btn_stop {
    background-color: #D04040;
    color: #F0E8E8;
    border: 1px solid #D04040;
    font-weight: 700;
    font-size: 10.5pt;
    padding: 8px 20px;
    border-radius: 5px;
}
QPushButton#btn_stop:hover {
    background-color: #B83232;
    border-color: #B83232;
}
QPushButton#btn_stop:pressed {
    background-color: #9A2626;
    border-color: #9A2626;
}
QPushButton#btn_stop:disabled {
    background-color: #17191F;
    color: #434957;
    border-color: #262B35;
}

/* Add Image / Add PDF — blue secondary */
QPushButton#btn_add_img,
QPushButton#btn_add_pdf {
    background-color: #1A2E54;
    color: #90B8F8;
    border: 1px solid #1E3560;
    border-radius: 5px;
}
QPushButton#btn_add_img:hover,
QPushButton#btn_add_pdf:hover {
    background-color: #1E3870;
    border-color: #3D7EE8;
    color: #B8D4FC;
}
QPushButton#btn_add_img:pressed,
QPushButton#btn_add_pdf:pressed {
    background-color: #132240;
    border-color: #1A2E54;
}
QPushButton#btn_add_img:disabled,
QPushButton#btn_add_pdf:disabled {
    background-color: #111318;
    color: #434957;
    border-color: #262B35;
}

/* Clear — neutral, red tint on hover */
QPushButton#btn_clear {
    background-color: #17191F;
    color: #7A8499;
    border: 1px solid #262B35;
    border-radius: 5px;
}
QPushButton#btn_clear:hover {
    background-color: #231418;
    border-color: #D04040;
    color: #D04040;
}
QPushButton#btn_clear:disabled {
    background-color: #111318;
    color: #434957;
    border-color: #262B35;
}

/* Toggle headers — checkable */
QPushButton#btn_toggle_headers {
    background-color: transparent;
    color: #7A8499;
    border: 1px solid #262B35;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 9.5pt;
}
QPushButton#btn_toggle_headers:hover {
    background-color: #17191F;
    color: #E8ECF4;
}
QPushButton#btn_toggle_headers:checked {
    background-color: #17191F;
    color: #3E9E6A;
    border-color: #2A5C40;
}
QPushButton#btn_toggle_headers:checked:hover {
    background-color: #1A2920;
}
QPushButton#btn_toggle_headers:disabled {
    color: #434957;
    border-color: #262B35;
}

/* Extract fields — blue accent, manual trigger */
QPushButton#btn_extract {
    background-color: #1A2E54;
    color: #90B8F8;
    border: 1px solid #1E3560;
    border-radius: 5px;
    padding: 5px 14px;
    font-size: 9.5pt;
    font-weight: 600;
}
QPushButton#btn_extract:hover {
    background-color: #1E3870;
    border-color: #3D7EE8;
    color: #B8D4FC;
}
QPushButton#btn_extract:pressed {
    background-color: #132240;
}
QPushButton#btn_extract:disabled {
    background-color: #111318;
    color: #434957;
    border-color: #262B35;
}

/* Copy / Copy JSON — ghost secondary */
QPushButton#btn_copy,
QPushButton#btn_copy_json {
    background-color: transparent;
    color: #7A8499;
    border: 1px solid #262B35;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 9.5pt;
}
QPushButton#btn_copy:hover,
QPushButton#btn_copy_json:hover {
    background-color: #17191F;
    color: #E8ECF4;
    border-color: #3D7EE8;
}

/* Navigation up/down */
QPushButton#btn_up,
QPushButton#btn_down {
    background-color: transparent;
    color: #7A8499;
    border: 1px solid #262B35;
    border-radius: 4px;
    font-size: 11pt;
    font-weight: 600;
    padding: 1px 4px;
}
QPushButton#btn_up:hover,
QPushButton#btn_down:hover {
    background-color: #17191F;
    color: #3D7EE8;
    border-color: #3D7EE8;
}
QPushButton#btn_up:disabled,
QPushButton#btn_down:disabled {
    color: #434957;
    border-color: #1D2029;
}

/* Toolbar ghost buttons */
QPushButton#btn_settings_toolbar,
QPushButton#btn_about_toolbar,
QPushButton#btn_unload_toolbar {
    background-color: transparent;
    color: #7A8499;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 9.5pt;
}
QPushButton#btn_settings_toolbar:hover,
QPushButton#btn_about_toolbar:hover,
QPushButton#btn_unload_toolbar:hover {
    background-color: #17191F;
    border-color: #262B35;
    color: #E8ECF4;
}

/* ────────────────────────────────────────────────────────────
   TEXT EDIT (OCR output)
   ──────────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #111318;
    border: 1px solid #262B35;
    color: #E8ECF4;
    border-radius: 4px;
    selection-background-color: #1A2E54;
    selection-color: #E8ECF4;
    padding: 10px 12px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
    line-height: 1.6;
}
QTextEdit:focus {
    border-color: #3D7EE8;
}

/* ────────────────────────────────────────────────────────────
   LIST WIDGET (file queue)
   ──────────────────────────────────────────────────────────── */
QListWidget {
    background-color: #111318;
    border: 1px solid #262B35;
    color: #E8ECF4;
    border-radius: 6px;
    selection-background-color: transparent;
    padding: 3px;
    outline: none;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    margin: 1px 2px;
    color: #7A8499;
    border: none;
}

QListWidget::item:hover {
    background-color: #17191F;
    color: #E8ECF4;
}

QListWidget::item:selected {
    background-color: #1D2029;
    color: #E8ECF4;
    border-left: 2px solid #3D7EE8;
    padding-left: 8px;
}

QListWidget::item:selected:hover {
    background-color: #1A2E54;
}

/* ────────────────────────────────────────────────────────────
   COMBO BOX
   ──────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #17191F;
    border: 1px solid #313847;
    color: #E8ECF4;
    padding: 5px 10px;
    border-radius: 5px;
    min-width: 80px;
}
QComboBox:hover { border-color: #3D7EE8; }
QComboBox:focus { border-color: #3D7EE8; }
QComboBox:disabled {
    background-color: #111318;
    color: #434957;
    border-color: #262B35;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7A8499;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #17191F;
    color: #E8ECF4;
    border: 1px solid #313847;
    border-radius: 5px;
    selection-background-color: #1A2E54;
    selection-color: #E8ECF4;
    outline: none;
    padding: 3px;
}

/* ────────────────────────────────────────────────────────────
   SPIN BOX
   ──────────────────────────────────────────────────────────── */
QSpinBox {
    background-color: #17191F;
    border: 1px solid #313847;
    color: #E8ECF4;
    padding: 5px 8px;
    border-radius: 4px;
}
QSpinBox:focus { border-color: #3D7EE8; }
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #1D2029;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #262B35;
}

/* ────────────────────────────────────────────────────────────
   LINE EDIT
   ──────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #111318;
    border: 1px solid #313847;
    color: #E8ECF4;
    padding: 6px 10px;
    border-radius: 4px;
    selection-background-color: #1A2E54;
}
QLineEdit:focus { border-color: #3D7EE8; }
QLineEdit:disabled {
    color: #434957;
    border-color: #262B35;
}

/* ────────────────────────────────────────────────────────────
   PROGRESS BAR — 4px, no text, blue fill
   ──────────────────────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 2px;
    background-color: #1D2029;
    color: transparent;
    font-size: 0px;
    min-height: 4px;
    max-height: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #3D7EE8;
    border-radius: 2px;
}

/* ────────────────────────────────────────────────────────────
   TAB WIDGET — underline indicator, no pane border
   ──────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #262B35;
    background-color: #111318;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background-color: #0D0E12;
}

QTabBar::tab {
    background-color: transparent;
    color: #7A8499;
    padding: 8px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-size: 9.5pt;
    font-weight: 600;
    min-width: 80px;
}

QTabBar::tab:selected {
    color: #3D7EE8;
    border-bottom: 2px solid #3D7EE8;
    background-color: transparent;
}

QTabBar::tab:hover:!selected {
    color: #E8ECF4;
    border-bottom: 2px solid #262B35;
}

QTabBar::tab:disabled {
    color: #434957;
}

/* ────────────────────────────────────────────────────────────
   SCROLL BARS — minimal, 7px track
   ──────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width: 7px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #262B35;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background-color: #434957;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 7px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #262B35;
    border-radius: 3px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #434957;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    border: none;
    background: none;
}

/* ────────────────────────────────────────────────────────────
   GROUP BOX
   ──────────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #262B35;
    border-radius: 6px;
    margin-top: 20px;
    font-weight: 600;
    font-size: 9.5pt;
    color: #7A8499;
    background-color: #111318;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #7A8499;
    font-size: 8.5pt;
    letter-spacing: 0.05em;
}

/* ────────────────────────────────────────────────────────────
   CONTEXT MENU
   ──────────────────────────────────────────────────────────── */
QMenu {
    background-color: #17191F;
    color: #E8ECF4;
    border: 1px solid #313847;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 3px;
    font-size: 10pt;
}
QMenu::item:selected {
    background-color: #1A2E54;
    color: #E8ECF4;
}
QMenu::separator {
    height: 1px;
    background: #262B35;
    margin: 3px 8px;
}

/* ────────────────────────────────────────────────────────────
   DIALOG
   ──────────────────────────────────────────────────────────── */
QDialog {
    background-color: #111318;
    color: #E8ECF4;
}
QDialogButtonBox QPushButton {
    min-width: 76px;
}
QFormLayout QLabel {
    color: #7A8499;
    font-size: 9.5pt;
}

/* ────────────────────────────────────────────────────────────
   DROP OVERLAY
   ──────────────────────────────────────────────────────────── */
#drop_overlay {
    background-color: rgba(13, 14, 18, 0.90);
    border: 1px solid #3D7EE8;
    border-radius: 6px;
}
#drop_overlay QLabel {
    color: #E8ECF4;
    font-size: 18pt;
    font-weight: 600;
}

/* ────────────────────────────────────────────────────────────
   EXTRACTED FIELDS PANEL
   ──────────────────────────────────────────────────────────── */
#extracted_panel {
    background-color: #111318;
}

#field_label {
    color: #7A8499;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 0.02em;
}

#field_value {
    color: #E8ECF4;
    font-size: 10pt;
    padding: 5px 10px;
    background-color: #17191F;
    border: 1px solid #262B35;
    border-radius: 4px;
    line-height: 1.5;
}
#field_value[empty="true"] {
    color: #434957;
    font-style: italic;
}

/* Loại bản badges — pill */
#badge_original {
    background-color: #1A3D28;
    color: #4DB87A;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.03em;
}
#badge_main {
    background-color: #1A2E54;
    color: #7DB4F8;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.03em;
}
#badge_photo {
    background-color: #3A2808;
    color: #E8A030;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.03em;
}
#badge_unknown {
    background-color: #1D2029;
    color: #434957;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 8.5pt;
    font-weight: 600;
}

/* ────────────────────────────────────────────────────────────
   STATUS BAR — 28px, secondary text, top border only
   ──────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #0D0E12;
    color: #7A8499;
    border-top: 1px solid #262B35;
    font-size: 8.5pt;
    min-height: 28px;
    max-height: 28px;
}
QStatusBar::item {
    border: none;
}
